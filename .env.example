# Three LLMs from DIFFERENT model families (avoids same-model bias in evaluation). Model ids are the proxy's.

# --- RAG generator (answers): src/alpha_audit/llm/generator.py ---
# OpenAI-compatible endpoint (e.g. a LiteLLM proxy)
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=sk-<your-virtual-key>
LLM_MODEL=gpt-6-luna
# Optional, reasoning models only (overrides config.yaml llm.answer_reasoning_effort)
# LLM_ANSWER_REASONING_EFFORT=medium

# --- Eval LLM: eval/build_goldset.py --synth/--recheck, eval/build_qa_set.py ---
EVAL_LLM_MODEL=azure.claude-haiku-5-5
# Optional: a different endpoint/key (default: LLM_BASE_URL / LLM_API_KEY)
# EVAL_LLM_BASE_URL=
# EVAL_LLM_API_KEY=
# Optional reasoning effort (unset = not sent). Claude Haiku via the proxy ignores it, and the vertex_ai.* route
# breaks structured output when it is sent, so leave unset for Claude.
# EVAL_LLM_GENERATION_REASONING_EFFORT=
# EVAL_LLM_CHECK_REASONING_EFFORT=

# --- Judge LLM: scores the generator's answers (eval/judge.py); must not share the generator's family ---
JUDGE_LLM_MODEL=gemini-3.8-flash
# Optional: a different endpoint/key (default: LLM_BASE_URL / LLM_API_KEY)
# JUDGE_LLM_BASE_URL=
# JUDGE_LLM_API_KEY=
# JUDGE_LLM_REASONING_EFFORT=
